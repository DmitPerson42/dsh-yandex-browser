{
  "name": "dsh-yandex-browser",
  "version": "2.0.0",
  "type": "module",
  "description": "DSH plugin: runs Yandex Browser with a persistent signed-in profile for the agent, and exposes tools to read and drive the pages inside it over the DevTools protocol.",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1"
  },
  "meta": {
    "title": "Yandex Browser",
    "description": "Persistent Yandex Browser profile for the agent, plus tools to read and drive pages over CDP."
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "yandex-browser",
    "cdp",
    "browser",
    "automation"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "install.ps1",
    "README.md",
    "README.en.md",
    "LICENSE",
    "icon.svg"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DmitPerson42/dsh-yandex-browser.git"
  }
}